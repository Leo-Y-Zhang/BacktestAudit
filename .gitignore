# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local data the user points the tool at (never commit someone's returns)
*.csv
*.parquet

# ...but DO ship the bundled demo input so the example runs out of the box.
!examples/sample_returns.csv

# Generated demo artifacts (recreated by examples/run_example.py; not tracked).
/examples/sample_report.html
/examples/sample_report.md

# listing build artifact (the buyer download zip, regenerable)
listing/*.zip
